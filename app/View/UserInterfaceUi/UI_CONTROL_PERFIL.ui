  <property name="styleSheet">
   <string notr="true">#Formulario_Datos_Empleado{
background-color: #fffefb;
}
[objectName*=&quot;contenedor&quot;]{
background: #fffefb;
border:none;
}
#contenedor_globalDerecha{
min-width: 400px;
}
#contenedor_baja{
background:#EE1D52;
border-radius:5px;
}
#label_wp_titulo_usuario{
color:#1d1c1c;
background-color: #fffefb;
font-size: 24px;
font-weight: bold;
padding-left: 5px;
text-transform: uppercase;
font-family: &quot;Arial&quot;;
padding-top: 5px;
}
#foto_empleadoperfil{
max-width:200px;
min-height:150px;
min-width:200px;
max-height:150px;
background:  qconicalgradient(cx:0, cy:0, angle:228.9, stop:0.136364 rgba(0, 63, 126, 255), stop:0.522222 rgba(0, 199, 255, 236));
border-radius: 12px;
image: url(:/logos/Icons/logos/cuadrado_sin_fondo.png);
}
[objectName*=&quot;btn_btn_&quot;]{
font-family: Arial;
font-size: 14px;
font-weight: bold;
color: #fffefb;
min-height: 30px;
border-radius: 5px;
background: #023375;
text-align: center;
padding-left: 5px;
padding-right: 5px;
}
[objectName*=&quot;btn_btn_&quot;]:hover{
background: #2196F3;
}
[objectName*=&quot;btn_btn_&quot;]:pressed{
background: #1B80D0;
}
[objectName*=&quot;etiquetaTitulo&quot;]{
font-family: Arial;
font-size: 16px;
font-weight: bold;
max-height:17px;
}
[objectName*=&quot;etiqueta_&quot;]{
font-family: Arial;
font-size: 12px;
font-weight:bold;
text-transform: capitalize;
color: #1d1c1c;
}
[objectName*=&quot;opcion&quot;]{
color: #1d1c1c;
}
[objectName*=&quot;etiquetaTituloDato_&quot;]{
font-family: Arial;
font-size: 18px;
font-weight:bold;
color: #1d1c1c;
}
[objectName*=&quot;etiquetaTitulo_&quot;]{
font-family: Arial;
font-size: 18px;
font-weight:bold;
color: #1d1c1c;
}
[objectName*=&quot;etiquetaDato_&quot;]{
font-family: Arial;
font-size: 17px;
font-weight:bold;
color: rgb(65, 65, 65);
}
[objectName*=&quot;txt_&quot;]{
background-color: rgb(245, 244, 241);
color: rgb(29, 28, 28);
border: none;
border-bottom: 1px solid;
border-radius: 5px;
font-size: 12px;
font-family: Arial;
min-width: 250px;
}
[objectName^=&quot;txt_&quot;]::focus{
border-bottom: 2px solid #00668c;
}
[objectName*=&quot;fecha_&quot;]{
border: none;
border-bottom: 1px solid #3b3c3d;
border-radius: 5px;
padding: 2px;
background-color: #f5f4f1;
font-size: 14px;
min-width:100px;
}
*[objectName*=&quot;fecha_&quot;]::drop-down{
subcontrol-origin: padding;
subcontrol-position: top right;
padding-right:5px;
width: 20%;
border-left-width: 1px;
borde-radius: 5px;
background-color: #F5F5F5;
}
*[objectName*=&quot;fecha_&quot;]::down-arrow{
image: url(:/Icons/Bootstrap/calendar2-date.svg);
width: 17%;
height: 17%;
padding-left:5px;
padding-right:5px;
background: #F5F5F5;
}
*[objectName*=&quot;fecha_&quot;]::focus{
border-bottom: 2px solid #00668c;
}

#fecha_baja{
background: transparent;
color:#fffefb;
border:none;
}
[objectName*=&quot;numerodecimal_&quot;]{
background-color: rgb(245, 244, 241);
color: rgb(29, 28, 28);
