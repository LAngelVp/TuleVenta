  <property name="styleSheet">
   <string notr="true">*{
color: #1d1c1c;
}
#Orden_compra{
background-color: #fffefb;
}
#contenedor_encabezado{
background-color: rgb(3, 51, 116);
height: 30px;
}
#label_wc_titulo_ordencompra{
color: #fffefb;
font-size: 18px;
font-weight:bold;
font-family:&quot;Arial&quot;;
}
[objectName*=&quot;contenedor&quot;]{ background: #fffefb; border:none;}
[objectName*=&quot;frame&quot;]{
background-color: #fffefb;
}
*[objectName*=&quot;etiqueta_&quot;]{
font-family: Arial;
font-size: 14px;
font-weight:bold;
}
*[objectName*=&quot;btn_btn_&quot;]{
background: #023375;
font-size: 14px;
font-family: Arial;
font-weight: bold;
min-height: 25px;
border: none;
border-radius: 5px;
color: #fffefb;
padding: 3px 5px;
}
*[objectName*=&quot;btn_btn_agregar&quot;]{
background-color: #00619a;
}
*[objectName*=&quot;btn_btn_&quot;]:hover{
background-color: #2196F3;
}
*[objectName*=&quot;btn_btn_&quot;]:pressed{
background: #1B80D0;
}
#btn_btn_agregar:hover{
background-color: #68a67d;
}
#btn_btn_agregar:pressed{
background-color: #578B69;
}
#btn_btn_cerrar{
background-color: #fffefb;
min-height:15px;
max-width:15px;
}
#btn_btn_cerrar:pressed{
background: rgb(222, 221, 218);
}
*[objectName*=&quot;txt_&quot;]{
background-color:#F5F5F5;
color: #1d1c1c;
border: none;
border-bottom: 1px solid;
border-radius: 5px;
font-size: 12px;
font-family: Arial;
}
*[objectName^=&quot;txt_&quot;]::focus{
border-bottom: 2px solid #00668c;
}
*[objectName*=&quot;numerodecimal_&quot;]{
background-color: #F5F5F5;
color: #1d1c1c;
border: none;
border-bottom: 1px solid;
border-radius: 5px;
font-size: 14px;
font-family: Arial;
}
*[objectName^=&quot;numerodecimal_&quot;]::focus{
border-bottom: 2px solid #00668c;
}
/*TABLA*/


[objectName*=&quot;tabla_&quot;] {
font-family: Arial;
font-size: 14px;
background: #E3E3E3;
border: 1px solid #4791F5;
}

[objectName*=&quot;tabla_&quot;] QTableView {
background-color: #ffffff;
alternate-background-color: #f0f0f0;
selection-background-color: #cce4ff;
selection-color: black;
}

/* Encabezados */
[objectName*=&quot;tabla_&quot;] QHeaderView::section {
background-color: #023375;
color: white;
font-size: 16px;
padding: 5px;
border: 1px solid gray;
}

[objectName*=&quot;tabla_&quot;] QHeaderView::horizontal,
[objectName*=&quot;tabla_&quot;] QHeaderView::vertical {
background-color: #023375;
color: white;
}

/* Ítems seleccionados */
[objectName*=&quot;tabla_&quot;] QTableView::item:selected {
background-color: #cce4ff;
color: black;
}
[objectName*=&quot;cajaOpciones&quot;] {
    border: none;
    border-bottom: 1px solid #787878 ;
    padding: 2px ;
    background-color: #F5F5F5 ;
    font-size: 14px ;
    min-width: 200px ;
    font-family: &quot;Arial&quot; ;
    color: #1d1c1c ;
	selection-background-color: #4791F5; 
}

/* ESTILO DEL DROPDOWN (LISTA) */
[objectName*=&quot;cajaOpciones&quot;] QListView {
    background: #F5F5F5 ;
    border-radius: 3px;
    outline: none;
}

/* ESTILO DE LOS ÍTEMS */
[objectName*=&quot;cajaOpciones&quot;] QListView::item {
    padding: 6px 10px ;
    margin: 2px ;
}
/* BOTÓN DESPLEGABLE */
[objectName*=&quot;cajaOpciones&quot;]::drop-down {
    subcontrol-origin: padding ;
    subcontrol-position: top right ;
    padding-right: 5px ;
    width: 20% ;
    border-left-width: 1px ;
    border-radius: 3px ;
    background-color: #F5F5F5 ;
}
/* FLECHA DESPLEGABLE */
[objectName*=&quot;cajaOpciones&quot;]::down-arrow {
    image: url(:/Icons/Bootstrap/filter-left.svg);
    width: 17% ;
    height: 17% ;
    padding-left: 5px ;
    padding-right: 5px ;
}

#contenedor_grupo{
border: 1px solid #023375;
color: #1d1c1c;
font-weight: bold;
font-family: Arial;
margin-top: 5px;
margin-left:15px;
margin-right:15px;
border-radius: 5px;
padding-left:15px;
padding-right: 15px;
padding-top:15px;
}
