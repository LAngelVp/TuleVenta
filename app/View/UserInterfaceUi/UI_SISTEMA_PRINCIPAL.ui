  <property name="styleSheet">
   <string notr="true">#Principal_sistema{
background-color: rgb(255, 255, 255);
}
[objectName*=&quot;w_&quot;]{
background: #fffefb;
}
#label_logoempresa{
image: url(:/Icons/IconosSVG/logo_dev_rous_blanco.png);
min-width:80px;
margin-top: 2px;
}
#w_cuerpo_contenido{
background: #fffefb;
}
[objectName^=&quot;btc&quot;]{
background-color: rgb(255, 255, 255);
	border: none;
	border-radius: 9px;
	min-width:35px;
	min-height:25px;
}
[objectName^=&quot;btc&quot;]:hover{
	background-color: rgb(214, 214, 214);
}
#w_encabezado{
background-color:#8494A4;
height:35px;
min-height: 35px;
max-height: 35px;
}
[objectName^=&quot;w_&quot;]{
background-color: #fffefb;
}
[objectName^=&quot;p_&quot;]{
background-color: rgb(255, 255, 255);
}
#w_cuerpo_menu{
min-width:40px;
max-width:220px;
background-color: #8494A4;
}
#label_fotousuario{
image: url(:/Icons/IconosSVG/perfil.png);
max-height:40px;
min-height:40px;
background-repeat: no-repeat;
background-position: center;
}
[objectName^=&quot;btn_laterales&quot;]{
background-color: transparent;
border: none;
min.width: 215px;
qproperty-iconSize: 35px 35px;
font-size: 14px;
color: #F8FAFC;
font-weight: bold;
}
[objectName^=&quot;btn_laterales&quot;]:hover {
border-left:2px solid #fffefb;
}
#btn_laterales_btn_burger{
icon-size: 15px;
border-radius: 4px;
max-width: 40px;
max-height: 25px;
}
#btn_laterales_btn_burger:hover{
background: #B0C5D1;
border-left: none;
}
#btn_laterales_btn_opciones{
max-height:30px;
min-height:30px;
}
[objectName^=&quot;p_&quot;]{
background-color: rgb(255, 255, 255);
}
#label_wp_fotousuario{
background-color:#71c4ef;
border:  1px solid #cccbc8;
}
#label_wp_fotousuario{
min-width: 100px;
max-width: 100px;
min-height: 100px;
max-height: 100px;
}
[objectName^=&quot;label_wp&quot;]{
font-family: Arial;
color: #1d1c1c;
font-size:12px;
}
#label_wp_nombreusuario{
font-size:20px;
font-weight:bold;
}
#label_wp_puestousuario{
font-size:16px;
}
#label_wp_telefonoempleado{
font-size:14px;
font-weight:bold;
color: #3b3c3d;
}
#w_datos_empleado{
background-color:#f5f4f1;
border-radius: 10px;
}
#btn_ver_datosempleado{
qproperty-iconSize: 20px 20px;
}</string>
